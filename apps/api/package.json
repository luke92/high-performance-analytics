{
  "name": "@hpa/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "bench": "tsx bench/run.ts",
    "fixtures:parity": "tsx scripts/export-parity-fixtures.ts",
    "native:build": "cmake-js build -d ../../cpp -O ../../cpp/build/addon -T hpa_addon --CDHPA_BUILD_ADDON=ON --CDHPA_BUILD_TESTS=OFF",
    "native:rebuild": "cmake-js rebuild -d ../../cpp -O ../../cpp/build/addon -T hpa_addon --CDHPA_BUILD_ADDON=ON --CDHPA_BUILD_TESTS=OFF",
    "native:check": "tsx scripts/native-check.ts",
    "bench:core:build": "cmake -S ../../cpp -B ../../cpp/build/bench -DCMAKE_BUILD_TYPE=Release -DHPA_BUILD_BENCH=ON -DHPA_BUILD_TESTS=OFF && cmake --build ../../cpp/build/bench --config Release --target hpa_bench",
    "bench:compare": "node --expose-gc --import tsx bench/compare.ts",
    "native:experimental:build": "cmake-js build -d ../../cpp -O ../../cpp/build/addon-experimental -T hpa_addon_experimental --CDHPA_BUILD_ADDON=ON --CDHPA_BUILD_EXPERIMENTAL_ADDON=ON --CDHPA_BUILD_TESTS=OFF",
    "bench:marshalling": "node --expose-gc --import tsx bench/marshalling.ts"
  },
  "dependencies": {
    "express": "^5.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "cmake-js": "8.0.0",
    "node-addon-api": "8.9.2",
    "tsx": "^4.0.0",
    "vitest": "^5.0.0"
  },
  "binary": {
    "napi_versions": [
      8
    ]
  }
}
